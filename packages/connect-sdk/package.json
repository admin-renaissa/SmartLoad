{
  "name": "@renverse/connect-sdk",
  "version": "0.3.0",
  "private": true,
  "description": "RenConnect client — IdMap + publish + outbox helpers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').accessSync('dist/index.js')\"",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "license": "UNLICENSED"
}
